# Cortecs (OpenAI-kompatibel, EU). Modellnamen laut /v1/models, Aufrufe noch ungeprüft.
# Key kommt aus .env (CORTECS_API_KEY), nie hier eintragen.
CHAT_BASE_URL=https://api.cortecs.ai/v1
CHAT_MODEL=qwen3.5-9b
CHAT_EXTRA_BODY={}
VISION_BASE_URL=https://api.cortecs.ai/v1
VISION_MODEL=qwen3.5-9b
EMBED_BASE_URL=https://api.cortecs.ai/v1
EMBED_MODEL=bge-m3
# api-Backends (RERANK_BACKEND=api / TRANSCRIBE_BACKEND=api mit *_BASE_URL=https://api.cortecs.ai/v1,
# Modelle bge-reranker-v2-m3 bzw. whisper-large-v3-turbo) erst nach Pruefung mit echtem Key aktivieren.
RERANK_BACKEND=local
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
TRANSCRIBE_BACKEND=local
TRANSCRIBE_MODEL=small
# GLiNER bleibt lokal
GLINER_MODEL=fastino/gliner2-base-v1

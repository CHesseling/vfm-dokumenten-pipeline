# Einzelwerte aus profile/*.env hier überschreiben
PROVIDER=ollama
# Nur lokal erreichbar. Auf einem Server 0.0.0.0 setzen UND API_TOKEN setzen.
APP_BIND=127.0.0.1
# Port der Oberflaeche auf dem Rechner (falls 8999 belegt ist)
# APP_PORT=8999
DATABASE_URL=postgresql+psycopg://vfm:vfm@db:5432/vfm
SQL_READONLY_URL=postgresql+psycopg://vfm_leser:vfm_leser@db:5432/vfm
# Auch fuer CLEF (Klassifikation ueber Cortecs) noetig, wenn sonst Ollama laeuft
CORTECS_API_KEY=
API_TOKEN=
# Mindest-Konfidenz fuer GliNER (0.05-0.95), in GUI/CLI je Lauf aenderbar
# GLINER_SCHWELLE=0.5
# Browser-Terminal (Shell im App-Container, mit sudo). Link "Terminal" in der Oberflaeche.
# TERMINAL=aus schaltet es ab. Nur lokal erreichbar; auf einem Server mit
# TERMINAL_BIND=0.0.0.0 unbedingt TERMINAL_PASS setzen.
# TERMINAL=an
# TERMINAL_PORT=7681
# TERMINAL_BIND=127.0.0.1
# TERMINAL_USER=admin
# TERMINAL_PASS=

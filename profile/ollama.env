# Lokales Profil: Ollama auf dem Host. Einzelwerte in .env ueberschreiben.
CHAT_BASE_URL=http://host.docker.internal:11434/v1
CHAT_MODEL=qwen3.5:4b
CHAT_EXTRA_BODY={"reasoning_effort":"none"}
VISION_BASE_URL=http://host.docker.internal:11434/v1
VISION_MODEL=qwen3-vl:8b
VISION_EXTRA_BODY={"think":false}
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_MODEL=bge-m3
# Ollama hat keinen Rerank-/Transkriptions-Endpunkt: lokal
RERANK_BACKEND=local
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
TRANSCRIBE_BACKEND=local
TRANSCRIBE_MODEL=small
# GLiNER laeuft immer lokal
GLINER_MODEL=fastino/gliner2-base-v1
